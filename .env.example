# Copy to .env.local for local dev, and set the same keys as BUILD-TIME
# environment variables in the Cloudflare Pages project.
#
# This site is a static export: NEXT_PUBLIC_* values are baked into the HTML at
# build time. Changing one in the Pages dashboard does nothing until you
# redeploy.

# Google Tag Manager container. Already defaults to GTM-5P3JLG2Q in code.
NEXT_PUBLIC_GTM_ID=GTM-5P3JLG2Q

# GA4 measurement id. Optional if GA4 is fired from inside GTM.
NEXT_PUBLIC_GA_ID=

# Google Ads conversion, fired directly from the page.
# Set BOTH to enable. Leave BOTH empty if the Ads conversion tag lives in GTM,
# otherwise every call and WhatsApp click is counted twice.
NEXT_PUBLIC_GADS_CONVERSION_ID=
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# Meta / Facebook Pixel. Optional.
NEXT_PUBLIC_META_PIXEL_ID=
